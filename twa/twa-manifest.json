      "chosenIcon": "https://nopalou.com/icons/icon-192.png"
    },
    {
      "name": "Mes favoris",
      "shortName": "Favoris",
      "url": "/favoris",
      "chosenIcon": "https://nopalou.com/icons/icon-192.png"
    }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://nopalou.com/manifest.json",
  "fallbackType": "customtabs",
  "features": {
    "locationDelegation": {
      "enabled": true
