# NOTE : si le dépôt Nopalou a déjà un .env, ne pas l'écraser. Fusionner ces variables avec
# celles existantes et réutiliser les services déjà configurés (voir docs/surga/INTEGRATION_NOPALOU.md).

# BASE DE DONNÉES
DATABASE_URL="postgresql://user:password@localhost:5432/nopalou?schema=public"

# RECHERCHE (Meilisearch)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="votre_cle_api_meilisearch"

# CACHE ET SESSIONS (Upstash Redis)
UPSTASH_REDIS_REST_URL="votre_url_upstash"
UPSTASH_REDIS_REST_TOKEN="votre_token_upstash"

# NOTIFICATIONS PUSH WEB (VAPID)
VAPID_PUBLIC_KEY="votre_cle_publique_vapid"
VAPID_PRIVATE_KEY="votre_cle_privee_vapid"
VAPID_SUBJECT="mailto:contact@nopalou.com"

# WHATSAPP BUSINESS API (Meta) : vérifier le numéro et les templates déjà utilisés ailleurs
WHATSAPP_TOKEN="votre_token_meta"
WHATSAPP_PHONE_ID="votre_id_telephone"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="surga_webhook_secret"

# AUTHENTIFICATION SMS : réutiliser le fournisseur existant
SMS_PROVIDER_ACCOUNT_SID="votre_sid"
SMS_PROVIDER_AUTH_TOKEN="votre_token"

# PAIEMENT MOBILE MONEY : réutiliser l'intégration existante
PAYDUNYA_MASTER_KEY="votre_cle_paydunya"
PAYDUNYA_PRIVATE_KEY="votre_cle_privee"
PAYDUNYA_TOKEN="votre_token_paydunya"

# IA : compréhension des commandes, résumés
ANTHROPIC_API_KEY="votre_cle_api_anthropic"

# TRANSCRIPTION VOCALE (fournisseur à choisir après le spike de la Phase 0)
STT_PROVIDER="a_definir"
STT_API_KEY="votre_cle_transcription"

# SYNTHÈSE VOCALE : option audio (fournisseur à choisir)
TTS_PROVIDER="a_definir"
TTS_API_KEY="votre_cle_synthese_vocale"

# QUOTAS (valeurs de départ à ajuster après mesure des coûts)
VOICE_FREE_DAILY_LIMIT="10"

# ACTUALITÉ ET SPORT
NEWS_RSS_FEED_URLS="https://exemple-source-1.sn/rss,https://exemple-source-2.sn/rss"
SPORTS_API_KEY="votre_cle_api_sportive"

# TRAFIC : source à valider (Phase 0)
TRAFFIC_API_KEY="a_definir"

# BONS PLANS
GOOGLE_PLACES_API_KEY="votre_cle_google_places"

# GIT
GITHUB_TOKEN="votre_token_github"
