# Frontend Next.js — Variables d'environnement (copier dans .env.local)

# ── JWT — Doit correspondre au JWT_SECRET backend ──────────────
JWT_SECRET=changez-moi-avec-une-valeur-aleatoire-64-caracteres

# ── Session ────────────────────────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=changez-moi-avec-une-valeur-aleatoire-64-caracteres

# ── Backend URL (server-side, non exposé au client) ────────────
BACKEND_URL=http://localhost:3000  # Dev local
# BACKEND_URL=https://api.nopalou.com  # Production

# ── Frontend URL (public, exposé au client dans les métadonnées)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000  # Dev local
# NEXT_PUBLIC_BACKEND_URL=https://api.nopalou.com  # Production

# ── Site canonical URL (pour les métadonnées SEO) ────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3001  # Dev local
# NEXT_PUBLIC_SITE_URL=https://nopalou.com  # Production

# ── Sentry — Monitoring frontend (free tier) ───────────────────
# DSN format : https://key@sentry.io/project-id
# Pour l'utiliser : npm install @sentry/nextjs @sentry/react
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
