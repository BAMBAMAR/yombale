# Nopalou — Variables d'environnement Next.js
# 1. Copier : cp .env.local.example .env.local
# 2. Remplir toutes les valeurs
# IMPORTANT : Ne jamais commiter .env.local sur Git !

NODE_ENV=development

# ── Backend URL ───────────────────────────────────────────────
# URL du backend Express (utilisée côté serveur dans les Server Actions)
BACKEND_URL=http://localhost:3000
# Même URL, exposée au navigateur (pour les requêtes client-side)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# ── Site URL ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nopalou.sn

# ── Secrets (REQUIRED) ────────────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=changez-moi-minimum-32-chars-aleatoires

# Doit être IDENTIQUE à la valeur JWT_SECRET du backend
JWT_SECRET=meme-valeur-que-backend-jwt-secret
