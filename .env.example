# PrixMalin — Variables d'environnement
# 1. Copier : cp .env.example .env
# 2. Remplir les valeurs
# IMPORTANT : Ne jamais commiter .env sur Git !

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://user:motdepasse@localhost:5432/prixmalin

# Redis
REDIS_URL=redis://localhost:6379

# JWT — générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changez-moi-avec-une-valeur-aleatoire-de-64-caracteres

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# Wave
WAVE_API_KEY=wv_prod_xxxxxxxx
WAVE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Orange Money
ORANGE_CLIENT_ID=xxxxxxxx
ORANGE_CLIENT_SECRET=xxxxxxxx
ORANGE_MERCHANT_KEY=xxxxxxxx

# Africa's Talking (SMS)
AT_API_KEY=atsk_xxxxxxxx
AT_USERNAME=prixmalin

# SendGrid (emails)
SENDGRID_API_KEY=SG.xxxxxxxx

# IDs marchands (remplir après npm run migrate)
JUMIA_API_KEY=xxxxxxxx
JUMIA_MARCHAND_ID=
EXPAT_MARCHAND_ID=