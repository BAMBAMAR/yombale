# Nopalou — Variables d'environnement backend
# 1. Copier : cp .env.example .env
# 2. Remplir toutes les valeurs marquées REQUIRED
# IMPORTANT : Ne jamais commiter .env sur Git !

NODE_ENV=development
PORT=3000

# ── PostgreSQL (REQUIRED) ──────────────────────────────────────
DATABASE_URL=postgresql://user:motdepasse@localhost:5432/nopalou

# ── JWT (REQUIRED) ─────────────────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changez-moi-avec-une-valeur-aleatoire-de-64-caracteres

# ── URLs (REQUIRED en production) ─────────────────────────────
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# ── Admin (REQUIRED) ──────────────────────────────────────────
ADMIN_SECRET=changez-moi-minimum-32-chars
ADMIN_EMAIL=admin@nopalou.com

# ── Resend — emails (REQUIRED en production) ──────────────────
# Dashboard : https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Après validation du domaine nopalou.com sur Resend :
EMAIL_FROM=Nopalou <noreply@nopalou.com>
# En développement vous pouvez utiliser : Nopalou <onboarding@resend.dev>

# ── Cloudinary — images (REQUIRED) ───────────────────────────
# Dashboard : https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=xxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Wave Senegal — paiement (REQUIRED si paiement activé) ─────
WAVE_API_KEY=wv_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WAVE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Orange Money — paiement (optionnel) ───────────────────────
ORANGE_CLIENT_ID=xxxxxxxxx
ORANGE_CLIENT_SECRET=xxxxxxxxx
ORANGE_MERCHANT_KEY=xxxxxxxxx

# ── WhatsApp Business API (Meta Cloud API) ────────────────────
# Dashboard : https://developers.facebook.com → Votre App → WhatsApp → Configuration API
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxx
WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Scrapers immo (optionnel) ─────────────────────────────────
FB_EMAIL=votre@email.com
FB_PASSWORD=votre_mot_de_passe
# ScraperAPI pour contourner blocages IP (1000 appels/mois gratuits)
# SCRAPER_PROXY_URL=http://api.scraperapi.com?api_key=VOTRE_CLE&url=

# ── Scraping ──────────────────────────────────────────────────
# Mettre true sur Render/Railway plan gratuit pour éviter les timeouts
SCRAPING_DISABLED=true

# ── Réseaux sociaux — publication automatique (optionnel) ─────
# Tutoriel complet : https://developers.facebook.com/docs/pages/getting-started
#
# 1. Créer une app Facebook sur developers.facebook.com
# 2. Ajouter le produit "Pages API"
# 3. Dans Graph API Explorer → générer un token Page avec permissions :
#    pages_manage_posts, pages_read_engagement, instagram_basic, instagram_content_publish
# 4. Convertir en token longue durée (60 jours) ou permanent via System User
#
# ID de votre Page Facebook (visible dans Paramètres > Paramètres de la Page)
FB_PAGE_ID=xxxxxxxxxxxxxxxxxx
#
# Token d'accès Page (pas le token utilisateur — le token PAGE)
FB_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# App ID et App Secret Meta (pour vérifier la durée de vie du token)
# Visible dans developers.facebook.com > Nopalou > Paramètres > Général
FB_APP_ID=xxxxxxxxxxxxxx
FB_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# ID du compte Instagram Business lié à votre Page Facebook
# (Instagram > Paramètres > Compte > Compte professionnel > ID)
IG_USER_ID=xxxxxxxxxxxxxxxxxx
#
# URL publique du site (utilisée dans les posts)
NEXT_PUBLIC_SITE_URL=https://nopalou.com
